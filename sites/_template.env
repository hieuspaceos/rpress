# Site bring-up config. Copy to sites/<name>.env and edit.
# Consumed by scripts/e2e-site.sh — every value the workflow needs lives here.

SITE=example            # slug, also the work/<SITE>/ dir name
NAME="Example Site"     # admin chrome brand
BIND=127.0.0.1:8420     # local serve address
LOCAL_URL=http://localhost:8420
HOST='*'                # host match; '*' = single-site catch-all
TOUR_BASE=voyage        # tour CPT URL segment (voyage|tours|...)

# Origin the dump came from — used for parity fetches and asset_origin.
SITE_URL=https://test.example.com

# pull source — remote via vps-ssh, or local paths. Pick one style:
VPS_HOST=ct4
WP_ROOT=/var/www/user/data/www/test.example.com
DUMP_REMOTE=/root/example-for-import.sql
# DUMP_LOCAL=/path/to/dump.sql
# WP_CONTENT_LOCAL=/path/to/wp-content

# REQUIRED for pull: per-site opt-in that the source is a clone/staging
# docroot, not production. Never set this for a live site.
CLONE_SOURCE_OK=yes
